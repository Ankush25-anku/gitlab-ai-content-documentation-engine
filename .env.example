# ---------- Backend (FastAPI) ----------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# SQLite for local dev; Supabase Postgres in production:
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./local.db

# Auth: "dev" = demo users (Bearer demo:<role>), "supabase" = verify Supabase JWTs
AUTH_MODE=dev
SUPABASE_URL=
# legacy HS256 secret; leave empty to verify with the project's JWKS
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# LLM: "mock" runs the whole pipeline offline; "crewai" uses real models through CrewAI
LLM_PROVIDER=mock
MOCK_LATENCY_MS=900
GEMINI_API_KEY=
# check current model names in the Gemini API docs
# flash-lite: more free-tier requests per minute and rarely overloaded
LLM_MODEL_DRAFT=gemini/gemini-2.5-flash-lite
LLM_MODEL_REVIEW=gemini/gemini-2.5-flash-lite
# used after 503/429 "model busy" errors survive 4 retries; must differ from the models above
# (each model has its own quota); leave empty to disable
GEMINI_FALLBACK_MODEL=gemini/gemini-flash-latest
# real LLM requests per minute, shared by all stages (Gemini free tier allows 5); 0 = no pacing
LLM_REQUESTS_PER_MINUTE=4
# hash (offline) | gemini
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=gemini-embedding-001
# must match vector(768) in the migration
EMBEDDING_DIM=768

# Optional: pin a prompt version per agent, e.g. PROMPT_VERSION_DOCUMENTATION_WRITER=1

# Publishing to a GitLab sandbox project (merge request export)
GITLAB_URL=https://gitlab.com
# numeric id or "group/project"
GITLAB_PROJECT_ID=
# project access token with api scope, sandbox project only
GITLAB_TOKEN=
GITLAB_TARGET_BRANCH=main
EXPORT_DIR=./exports

# Security
ALLOWED_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=5
INPUT_RETENTION_DAYS=30

# ---------- Frontend (Next.js) — put these in frontend/.env.local ----------
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
